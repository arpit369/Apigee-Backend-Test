<!-- Reads the client secret from an encrypted KVM into private.client_secret.
     Create the KVM first (see README): map 'oauth-config', key 'client_secret'. -->
<KeyValueMapOperations name="KVM-Get-Secret" mapIdentifier="oauth-config">
  <Scope>environment</Scope>
  <Get assignTo="private.client_secret">
    <Key><Parameter>client_secret</Parameter></Key>
  </Get>
</KeyValueMapOperations>
